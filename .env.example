# ── Database (bắt buộc) ──────────────────────────────────────────────
# Postgres CÓ extension pgvector. Free tier: https://neon.tech (tạo project,
# copy connection string, đổi "postgresql://" thành "postgresql+psycopg://").
# Chạy cục bộ bằng Docker:
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres pgvector/pgvector:pg16
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/edututor

# ── LLM (bắt buộc — chọn một) ────────────────────────────────────────
# Mặc định là OpenAI (app/llm/client_factory.py) — cần key này.
# Lấy tại https://platform.openai.com/api-keys (KHÔNG có free tier, tính phí
# theo token ngay từ request đầu tiên).
OPENAI_API_KEY=

# Tuỳ chọn — GEMINI_API_KEY tại https://aistudio.google.com/apikey (free tier).
# Để trống OPENAI_API_KEY và điền key này thì hệ thống tự rơi về Gemini, không
# cần sửa code. Đặt LLM_PROVIDER=gemini để ép dùng Gemini dù đã có cả hai key.
GEMINI_API_KEY=
# LLM_PROVIDER=openai

# ── Embedding + Rerank (bắt buộc) ────────────────────────────────────
# Cohere — embed-multilingual-v3.0 (app/ingestion/embedder.py) và
# rerank-multilingual-v3.0 (app/retrieval/reranker.py). Free trial key tại
# https://dashboard.cohere.com/api-keys.
COHERE_API_KEY=
# COHERE_EMBED_MODEL=embed-multilingual-v3.0
# COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# ── Lưu trữ file gốc (bắt buộc) ───────────────────────────────────────
# Backblaze B2 (app/storage.py) — S3-compatible, 10GB free, không cần thẻ tín
# dụng. Tạo Bucket VÀ Application Key (hai bước riêng trên dashboard):
#   1. Buckets -> Create a Bucket (tên tuỳ ý, không nhất thiết là "edututor-uploads")
#   2. App Keys -> Add a New Application Key -> giới hạn quyền vào đúng bucket vừa tạo
# Endpoint hiện trên trang bucket, dạng https://s3.<region>.backblazeb2.com.
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=edututor-uploads

# ── Frontend ──────────────────────────────────────────────────────────
# Domain frontend thật (Vercel...) — để trống thì CORS chỉ chấp nhận
# http://localhost:5173 (xem app/main.py::compute_allowed_origins).
FRONTEND_URL=
